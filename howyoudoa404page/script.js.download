document.addEventListener("DOMContentLoaded", () => {
  const projectsContainer = document.getElementById("projectsContainer");

  // Detect homepage vs projects page
  const isHomepage = document.getElementById("scrollProjectsBtn") || document.getElementById("projectsSection") && window.location.pathname === "/";

  if (isHomepage) {
    // Homepage: manual projects
    const myProjects = [
      { name: "Live Text Editor", description: "i was bored.", url: "https://gattodev.tech/projects/liveeditor", fork: false },
    ];
    renderProjects(myProjects);
  } else if (projectsContainer) {
    // Projects page: fetch from API
    loadProjectsFromAPI();
  }

  // Function to fetch GitHub repos from API
  async function loadProjectsFromAPI() {
    projectsContainer.innerHTML = `<div class="text-center text-gray-400 mb-4">Loading...</div>`;
    try {
      const res = await fetch("/projects/github/");
      if (!res.ok) throw new Error("API error");
      const repos = await res.json();
      if (!repos.length) {
        projectsContainer.innerHTML = `<p class="text-gray-400 text-center">No repositories found.</p>`;
        return;
      }
      renderProjects(repos, true);
    } catch (err) {
      projectsContainer.innerHTML = `<p class="text-red-400 text-center">Failed to load projects.</p>`;
      console.error(err);
    }
  }

  // Function to render projects
  function renderProjects(projects, isAPI = false) {
    if (!projectsContainer) return;
    projectsContainer.innerHTML = "";

    projects.forEach((project, index) => {
      const forkHTML = project.fork
        ? `<span class="tooltip flex items-center">
             <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 mr-1" fill="currentColor" viewBox="0 0 16 16">
               <path d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm0 2.122a2.25 2.25 0 1 0-1.5 0v1.005c0 .374.176.723.475.943L7 10.128v2.622a2.25 2.25 0 1 0 1.5 0V10.13l3.025-2.838c.299-.22.475-.569.475-.943V5.372a2.25 2.25 0 1 0-1.5 0v.977L8 9.128 5 6.35v-.978Zm6-2.122a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0Zm-.75 10.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
             </svg>
             <span class="tooltip-text flex items-center gap-1">
               <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-gray-400" fill="currentColor" viewBox="0 0 16 16">
                 <path d="M5 3.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm0 2.122a2.25 2.25 0 1 0-1.5 0v1.005c0 .374.176.723.475.943L7 10.128v2.622a2.25 2.25 0 1 0 1.5 0V10.13l3.025-2.838c.299-.22.475-.569.475-.943V5.372a2.25 2.25 0 1 0-1.5 0v.977L8 9.128 5 6.35v-.978Zm6-2.122a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0Zm-.75 10.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
               </svg>
               This repository is a fork.
             </span>
           </span>`
        : "";

      const card = document.createElement("div");
      card.className = "bg-gray-700 p-6 rounded-xl shadow-lg hover:shadow-xl transform hover:scale-105 transition project-card";
      card.style.animationDelay = `${index * 0.1}s`;
      card.innerHTML = `
        <h4 class="text-xl font-semibold mb-2 flex items-center">
          ${forkHTML} ${project.name}
        </h4>
        <p class="text-gray-300 mb-4">${isAPI ? project.description || "No description" : project.description}</p>
        <a href="${isAPI ? project.html_url || project.url : project.url}" target="_blank" class="underlinehover text-blue-400">View Project</a>
      `;
      projectsContainer.appendChild(card);
    });
  }

});
